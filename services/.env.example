# Copy this file to .env for local use. The .env file is ignored by Git.

# pgAdmin credentials for the local development environment.
PGADMIN_EMAIL=admin@example.test
PGADMIN_PASSWORD=replace-with-a-local-password

# Optional: used only with `docker compose --profile tailscale`.
# Replace this placeholder with a temporary Tailscale auth key; do not commit it.
WEB_GATEWAY_TS_AUTHKEY=replace-with-a-temporary-auth-key
